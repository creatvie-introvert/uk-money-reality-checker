# No secrets are required by the calculator.
# Set SITE_URL only after canonical-host sign-off. HTTPS origin, no path/query.
# Without it the site works, robots omits Sitemap, and /sitemap.xml returns 503.
# SITE_URL=
# Optional test runner settings (never NEXT_PUBLIC variables):
# SMOKE_BASE_URL=  # Explicitly authorised target origin; otherwise localhost:3100.
# SMOKE_EXPECT_SITE_URL=  # Approved canonical origin expected in deployed sitemap.
